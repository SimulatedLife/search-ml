    given-names: Dheeraj Kumar
    affiliation: "Supercomputing Facility for Bioinformatics and Computational Biology (SCFBio), IIT Delhi"
    email: dheeraj@scfbio-iitd.res.in
repository-code: "https://github.com/SimulatedLife/search-ml"
url: "https://scfbio.iitd.ac.in/search-ml/"
keywords:
  - virtual screening
  - drug discovery
  - binding affinity
  - machine learning
  - target identification
